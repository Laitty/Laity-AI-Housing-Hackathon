{
  "name": "pittsburgh-parcel-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test server/*.test.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@turf/area": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
